{
  "manifest_version": 3,
  "name": "Nebula Match for YouTube",
  "version": "0.1.0",
  "description": "Adds Nebula links on matching YouTube watch and channel pages using public Nebula APIs.",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [],
  "host_permissions": [
    "https://content.api.nebula.app/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://www.youtube.com/watch*",
        "https://www.youtube.com/@*",
        "https://www.youtube.com/channel/*",
        "https://www.youtube.com/c/*"
      ],
      "js": [
        "lib/runtime.js",
        "content.js"
      ],
      "run_at": "document_idle"
    }
  ]
}
